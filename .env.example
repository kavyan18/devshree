# ===============================================
# DEVSHREE HARDWARE STORE — ENVIRONMENT CONFIG TEMPLATE
# Copy this file to .env and configure your production values.
# NEVER commit .env to version control!
# ===============================================

# 1. Serverless Admin Credentials (Used by /api/auth/login)
ADMIN_EMAIL=admin@devshree.in
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123

# 2. Firebase Public Web Configuration (Required for Firestore / Auth)
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=devshree-2dfae.firebaseapp.com
FIREBASE_PROJECT_ID=devshree-2dfae
FIREBASE_STORAGE_BUCKET=devshree-2dfae.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=140419631249
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# 3. Razorpay Payment Gateway (Optional - for live UPI/Card payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 4. WhatsApp & Store Owner Dispatch
STORE_OWNER_PHONE=918866130409
WA_WEBHOOK_URL=

# 5. Configurable Rate Limiting
RATE_LIMIT_AUTH_ACCOUNT_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=2000
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2
RATE_LIMIT_AUTH_BACKOFF_MAX_MS=300000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_AUTHED_MAX_REQUESTS=240
RATE_LIMIT_AUTHED_WINDOW_MS=60000

