rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email.matches('.*@devshree\\.in') ||
        request.auth.token.email == 'devshree@gmail.com' ||
        request.auth.token.email == 'pilojparakavyan7@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog read access
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Customer orders & GST invoices
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Store configuration & settings (maintenance mode, store contact, payment UPI)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}