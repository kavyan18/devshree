rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Strict image validation: size <= 5MB, strict MIME type, no SVG/executable code
    function isValidImage() {
      return request.resource.size > 0 &&
             request.resource.size <= 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|png|webp)') &&
             !request.resource.contentType.matches('image/svg.*');
    }

    // Product images: Public read, admin write only with strict validation
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      isValidImage() &&
                      fileName.matches('^[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp)$');
    }

    // Category banners & assets: Public read, admin write only with strict validation
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      isValidImage() &&
                      fileName.matches('^[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp)$');
    }

    // Customer profile avatars / verification: Owned by authenticated user
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      isValidImage() &&
                      fileName.matches('^[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp)$');
    }
  }
}
